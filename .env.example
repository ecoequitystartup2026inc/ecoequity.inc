# Copy this file to ".env.local" and fill in real values.
# Create React App only exposes vars prefixed with REACT_APP_ to the browser.
# NEVER put a secret key (service_role, PayMongo secret) in a REACT_APP_ var —
# those live only in Supabase Edge Function secrets (see BACKEND_SETUP.md).

# Supabase → Project Settings → API
REACT_APP_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-public-key

# OPTIONAL. Where signup-confirmation / password-reset links come back to.
# Leave it unset and the app uses whatever origin is serving the page, so the
# same build works on localhost and on the live site. Set it only to force every
# emailed link to one URL. No trailing slash, and the value must also be in
# Supabase → Authentication → URL Configuration → Redirect URLs.
# REACT_APP_SITE_URL=https://your-live-site.com

# PayMongo PUBLIC key (pk_test_...) — safe in the browser, used for the
# checkout widget only. The secret key (sk_test_...) stays server-side.
REACT_APP_PAYMONGO_PUBLIC_KEY=pk_test_xxx

# --- AI chat ---------------------------------------------------------------
# There is deliberately NO REACT_APP_ var for the AI provider key. Create React
# App inlines every REACT_APP_ value into the public JS bundle, so a key put
# here would be readable by anyone with DevTools and billable to you.
#
# The key lives only in Supabase Edge Function secrets:
#   supabase secrets set AI_PROVIDER=gemini GEMINI_API_KEY=xxx      # free tier
#   supabase secrets set AI_PROVIDER=openai OPENAI_API_KEY=sk-xxx   # prepaid
#
# Both providers can run at once, the second answering only when the first
# errors out (which on Gemini's free tier means a rate limit):
#   supabase secrets set AI_PROVIDER=gemini AI_FALLBACK_PROVIDER=openai \
#     GEMINI_API_KEY=xxx OPENAI_API_KEY=sk-xxx
#
# See BACKEND_SETUP.md → "Turn on the live AI chat".
