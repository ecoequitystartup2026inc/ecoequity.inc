# Copy this file to ".env.local" and fill in real values.
# Create React App only exposes vars prefixed with REACT_APP_ to the browser.
# NEVER put a secret key (service_role, PayMongo secret) in a REACT_APP_ var —
# those live only in Supabase Edge Function secrets (see BACKEND_SETUP.md).

# Supabase → Project Settings → API
REACT_APP_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-public-key

# PayMongo PUBLIC key (pk_test_...) — safe in the browser, used for the
# checkout widget only. The secret key (sk_test_...) stays server-side.
REACT_APP_PAYMONGO_PUBLIC_KEY=pk_test_xxx
